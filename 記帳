<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>淡紫記帳</title>
    <!-- iOS PWA 設置 -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="淡紫記帳">
    
    <!-- 引入 Tailwind CSS (排版) 與 Lucide Icons (圖標) -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        :root { --main-purple: #c38ed5; }
        body { 
            background-color: #f8f9fa; 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
        .main-card {
            background: linear-gradient(135deg, #ffffff 0%, #fdfaff 100%);
            border-radius: 2rem;
            box-shadow: 0 10px 25px -5px rgba(195, 142, 213, 0.2);
        }
        .nav-active { color: var(--main-purple); font-weight: bold; }
        .glass-header {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
    </style>
</head>
<body class="select-none">

    <!-- 頂部狀態列與標題 -->
    <div class="fixed top-0 w-full z-50 glass-header pt-12 pb-4 px-6 flex justify-between items-center">
        <div class="flex items-center space-x-2">
            <div class="w-8 h-8 rounded-lg bg-[#c38ed5] flex items-center justify-center text-white">
                <i data-lucide="book-open" class="w-5 h-5"></i>
            </div>
            <span class="text-lg font-bold text-gray-700">默認帳本</span>
        </div>
        <div class="flex space-x-4">
            <i data-lucide="search" class="w-6 h-6 text-gray-400"></i>
            <i data-lucide="calendar" class="w-6 h-6 text-gray-400"></i>
        </div>
    </div>

    <!-- 主要內容區 -->
    <main class="pt-32 px-5 pb-32">
        
        <!-- 資產概覽卡片 -->
        <div class="main-card p-6 mb-6">
            <div class="flex justify-between items-center mb-6">
                <span class="text-sm text-gray-400 font-medium">2025年6月</span>
                <i data-lucide="chevron-right" class="w-4 h-4 text-gray-300"></i>
            </div>
            
            <div class="grid grid-cols-3 gap-4 text-center">
                <div>
                    <p class="text-[10px] text-gray-400 mb-1">總額</p>
                    <p class="text-sm font-bold text-green-500">$9,040.94</p>
                </div>
                <div>
                    <p class="text-[10px] text-gray-400 mb-1">收入</p>
                    <p class="text-sm font-bold text-[#c38ed5]">$10,000</p>
                </div>
                <div>
                    <p class="text-[10px] text-gray-400 mb-1">支出</p>
                    <p class="text-sm font-bold text-red-400">$959.06</p>
                </div>
            </div>
        </div>

        <!-- 預算進度 (複刻圖片) -->
        <div class="bg-white rounded-2xl p-5 shadow-sm mb-6">
            <div class="flex justify-between items-center mb-3">
                <div class="flex items-center space-x-2">
                    <i data-lucide="target" class="w-4 h-4 text-[#c38ed5]"></i>
                    <span class="text-sm font-medium text-gray-600">本月預算</span>
                </div>
                <span class="text-xs text-gray-400">已用 9%</span>
            </div>
            <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                <div class="bg-[#c38ed5] h-full" style="width: 9%"></div>
            </div>
        </div>

        <!-- 儲蓄目標 (滑動區塊預留) -->
        <h3 class="text-sm font-bold text-gray-700 mb-4 px-1">存錢目標</h3>
        <div class="flex space-x-4 overflow-x-auto pb-4 no-scrollbar">
            <div class="min-w-[120px] bg-white p-4 rounded-2xl shadow-sm text-center">
                <i data-lucide="car" class="w-8 h-8 mx-auto text-blue-400 mb-2"></i>
                <p class="text-xs text-gray-500">買車車</p>
                <p class="text-[10px] text-gray-300">0%</p>
            </div>
            <div class="min-w-[120px] bg-white p-4 rounded-2xl shadow-sm text-center">
                <i data-lucide="monitor" class="w-8 h-8 mx-auto text-purple-400 mb-2"></i>
                <p class="text-xs text-gray-500">New PC</p>
                <p class="text-[10px] text-gray-300">0%</p>
            </div>
        </div>
    </main>

    <!-- 底部導航欄 -->
    <nav class="fixed bottom-0 w-full bg-white border-t border-gray-100 safe-bottom flex justify-around py-3 z-50">
        <div class="flex flex-col items-center nav-active">
            <i data-lucide="book" class="w-6 h-6"></i>
            <span class="text-[10px] mt-1">記帳本</span>
        </div>
        <div class="flex flex-col items-center text-gray-300">
            <i data-lucide="wallet" class="w-6 h-6"></i>
            <span class="text-[10px] mt-1">錢包</span>
        </div>
        <div class="flex flex-col items-center text-gray-300">
            <i data-lucide="pie-chart" class="w-6 h-6"></i>
            <span class="text-[10px] mt-1">分析</span>
        </div>
        <div class="flex flex-col items-center text-gray-300">
            <i data-lucide="more-horizontal" class="w-6 h-6"></i>
            <span class="text-[10px] mt-1">更多</span>
        </div>
    </nav>

    <!-- 懸浮記帳按鈕 (複刻圖片右下角) -->
    <button class="fixed right-6 bottom-24 w-14 h-14 bg-[#c38ed5] rounded-full shadow-lg flex items-center justify-center text-white z-40">
        <i data-lucide="pencil-line" class="w-6 h-6"></i>
    </button>

    <script>
        // 初始化所有圖標
        lucide.createIcons();
    </script>
</body>
</html>
